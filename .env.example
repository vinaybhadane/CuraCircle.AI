# CuraCircle AI Environment Configuration
# GenAI Model: gemini 3.5 flash strictly
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Brevo (Sendinblue) Transactional Email API Key
BREVO_API_KEY=
BREVO_SENDER_EMAIL=alerts@curacircle.health
BREVO_SENDER_NAME=CuraCircle Health Alerts

# Authentication Secret (for JWT Care Circle session tokens)
JWT_SECRET=curacircle_super_secure_jwt_token_secret_key_32_bytes_min

# Email Dispatcher Configuration (Proactive reminders)
# If empty, CuraCircle runs with built-in Interactive Outbox Previewer (zero config required)
# For real SMTP (e.g. Gmail, SendGrid, Resend, Amazon SES):
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=alerts@curacircle.health

# System Settings
PORT=3000
NODE_ENV=development
